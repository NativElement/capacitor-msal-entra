# This file is NOT part of the plugin — it lives in your Ionic app at
# ios/App/Podfile and is owned/regenerated by Capacitor. Shown here only so
# you can see what `npx cap sync ios` produces after you add this plugin as
# a dependency in your app's package.json.
#
# You should NOT need to hand-edit this for the plugin itself — CocoaPods
# resolves `s.dependency 'MSAL'` from NativelementCapacitorMsalEntra.podspec
# automatically.
# The one thing worth watching: if `pod install` complains about static vs.
# dynamic linkage for MSAL, add `use_frameworks!` (MSAL supports either,
# but some Capacitor plugin combinations are picky) — try without it first,
# Capacitor 7's default static-library setup usually works fine.

platform :ios, '15.0'
use_modular_headers!

def capacitor_pods
  pod 'Capacitor', :path => '../../node_modules/@capacitor/ios'
  pod 'CapacitorCordova', :path => '../../node_modules/@capacitor/ios'

  # Auto-added by `npx cap sync ios` because @nativelement/capacitor-msal-entra's
  # package.json declares capacitor.ios.src = "ios" and
  # node_modules/@nativelement/capacitor-msal-entra contains
  # NativelementCapacitorMsalEntra.podspec:
  pod 'NativelementCapacitorMsalEntra', :path => '../../node_modules/@nativelement/capacitor-msal-entra'
end

target 'App' do
  capacitor_pods
  # MSAL itself does NOT need a manual line here — it comes in transitively
  # via NativelementCapacitorMsalEntra.podspec's `s.dependency 'MSAL', '~> 1.2'`.
end
