{
  "name": "@nativelement/capacitor-msal-entra",
  "version": "1.0.0",
  "description": "Capacitor plugin wrapping native MSAL SDKs (Android/iOS) and msal-browser (web) for Microsoft Entra External ID authentication",
  "main": "dist/plugin.cjs.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "dist/",
    "ios/Plugin/",
    "web/",
    "CapacitorMsalEntraPlugin.podspec",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "author": "Nativelement",
  "license": "MIT",
  "scripts": {
    "clean": "rm -rf ./dist",
    "build": "npm run clean && tsc && rollup -c rollup.config.js",
    "watch": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.22.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "rollup": "^4.9.0",
    "typescript": "^5.4.0"
  },
  "peerDependencies": {
    "@capacitor/core": ">=6.0.0"
  },
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  },
  "keywords": [
    "capacitor",
    "plugin",
    "msal",
    "entra",
    "entra-external-id",
    "azure-ad",
    "ciam",
    "authentication",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nativelement/capacitor-msal-entra.git"
  },
  "bugs": {
    "url": "https://github.com/nativelement/capacitor-msal-entra/issues"
  },
  "homepage": "https://github.com/nativelement/capacitor-msal-entra#readme",
  "publishConfig": {
    "access": "public"
  }
}
